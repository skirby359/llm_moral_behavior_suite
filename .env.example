# Copy this file to `.env` and fill in your key. `.env` is gitignored and is
# loaded automatically by every `ombs` command.

# Anthropic frontier provider (Phase 8). Required for the anthropic provider.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ollama host (default shown). Override if Ollama runs elsewhere.
OLLAMA_HOST=http://localhost:11434

# Other frontier providers (still stubs — not used yet).
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
